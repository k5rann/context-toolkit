{
  "name": "context-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node scripts/smoke-humanizer.mjs",
    "smoke:prod": "node scripts/smoke-humanizer.mjs --url=https://context-toolkit.vercel.app",
    "typecheck": "tsc --noEmit",
    "research:humanizer-models": "node scripts/run-humanizer-model-swap.mjs",
    "research:burstiness": "node scripts/measure-burstiness.mjs",
    "test:burstiness": "node scripts/test-burstiness.mjs",
    "research:phrase-dict": "node scripts/measure-phrase-dict.mjs",
    "test:phrase-dict": "node scripts/test-phrase-dict.mjs",
    "test:structural": "node scripts/test-structural.mjs",
    "test:humanizer-stack": "node scripts/test-humanizer-stack.mjs",
    "humanize": "node scripts/humanize-cli.mjs",
    "phrase-chase:generate": "node scripts/generate-phrase-chase-outputs.mjs",
    "backtest:humanizer": "node scripts/backtest-humanizer.mjs",
    "style-anchor": "node scripts/style-anchor-rewrite.mjs",
    "style-anchor:list": "node scripts/style-anchor-rewrite.mjs --list-anchors",
    "compare:chain-vs-stealth": "node --env-file=.env.local scripts/compare-chain-vs-stealth.mjs",
    "verify:sapling": "node --env-file=.env.local scripts/sapling-verify.mjs",
    "collect:sw-pairs": "node --env-file=.env.local scripts/collect-stealthwriter-pairs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/generative-ai": "^0.24.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
